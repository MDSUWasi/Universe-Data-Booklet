# -------------------------------------------------------------
# LARGE RASTER DATA - Not in git, re-downloadable from sources
# -------------------------------------------------------------
data/**/*.tif
data/**/*.tiff
data/**/*.img
data/**/*.asc
data/**/*.grd
output/**/*.tif
output/**/*.tiff
output/**/*.img
output/**/*.nc
output/**/*.h5

# -------------------------------------------------------------
# AUXILIARY / SIDECHAIN FILES - Generated by GIS software
# -------------------------------------------------------------
*.aux.xml
*.log
*.tmp
*.bak
*.backup
*~
*.swp
*.swo
.DS_Store
Thumbs.db

# -------------------------------------------------------------
# PYTHON / EDITOR ARTIFACTS
# -------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
.pycache/
.vscode/
.idea/

# -------------------------------------------------------------
# ARCHIVE / BACKUP FOLDERS
# -------------------------------------------------------------
_quarantine_*/
_archive_*/
.manifest_*
audit_report*.txt
audit_report*.html

# -------------------------------------------------------------
# JUPYTER
# -------------------------------------------------------------
.ipynb_checkpoints/

# -------------------------------------------------------------
# BACKEND / FRONTEND
# -------------------------------------------------------------
node_modules/
package-lock.json
yarn.lock
venv/
.venv/
env/
*.sqlite
*.db
.env
.env.local
dist/
build/
.next/
.cache/

