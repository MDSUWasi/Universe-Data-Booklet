# ============================================
# Universe Data Booklet - Environment Config
# ============================================
# Copy this file to `.env` and adjust values.

# Server port
SERVER_PORT=8081

# NASA API Key
# The app works out-of-the-box with the free public "DEMO_KEY".
# For higher rate limits, sign up for a free key at:
#   https://api.nasa.gov/
NASA_API_KEY=DEMO_KEY

# Production mode: set to false to remove error details
DEBUG_MODE=false

# Cache refresh threshold (days) - how often to re-fetch asteroids
REFRESH_THRESHOLD_DAYS=7

# Max cache age (days) - delete cached files older than this
MAX_CACHE_AGE_DAYS=90

# --- Security / Performance (optional) ---

# Host interface to bind to (0.0.0.0 for all interfaces in containers)
HOST=0.0.0.0

# CORS allow-list (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:8081

# Rate limiting
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120

# Gzip compression
GZIP_MIN_BYTES=512

# HTTP caching (seconds)
STATIC_CACHE_SECONDS=86400
API_CACHE_SECONDS=60

# --- Deployment-specific ---

# Set to "true" when behind a TLS-terminating reverse proxy (nginx)
# so the server knows to trust X-Forwarded-Proto headers.
TRUSTED_PROXY=false