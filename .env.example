# ============================================
# Universe Data Booklet - Environment Config
# ============================================
# Copy this file to `.env` and adjust values.

# Server port
SERVER_PORT=8081

# NASA API Key
# The app works out-of-the-box with the free public "DEMO_KEY".
# For higher rate limits, sign up for a free key at:
#   https://api.nasa.gov/
NASA_API_KEY=DEMO_KEY

# Production mode: set to false to remove error details
DEBUG_MODE=false

# Cache refresh threshold (days) - how often to re-fetch asteroids
REFRESH_THRESHOLD_DAYS=30

# Max cache age (days) - delete cached files older than this
MAX_CACHE_AGE_DAYS=90
